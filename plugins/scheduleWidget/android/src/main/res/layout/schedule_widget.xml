<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#F7F5EC">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCHEDULE · NEXT CLASS"
        android:textColor="#236B50"
        android:textSize="10sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_class_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="No upcoming class"
        android:textColor="#1F2937"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_class_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Your timetable is clear"
        android:textColor="#718096"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_class_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="No upcoming class"
        android:textColor="#174F3B"
        android:textSize="12sp"
        android:textStyle="bold" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="8dp"
        android:background="#E7E9E3" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT DEADLINE"
        android:textColor="#8A623A"
        android:textSize="10sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="No pending deadline"
        android:textColor="#1F2937"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_task_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="No upcoming deadline"
        android:textColor="#718096"
        android:textSize="11sp" />
</LinearLayout>
